# DiabetaBot environment template. Copy to .env and fill real values.
# Never commit the populated .env file.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- LLM provider (OpenAI-compatible, all configurable) ---
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=your-api-key
CHAT_MODEL_NAME=your-chat-model
RAG_TOP_K=5
# Candidate pool retrieved before name-grounding; must be >= RAG_TOP_K.
RAG_CANDIDATE_K=20
LLM_TEMPERATURE=0.0

# --- Embeddings: self-hosted Ollama (snowflake-arctic-embed2, 1024 dim) ---
# Mode A: bundled `ollama` compose service (default below).
# Mode B: external host; also add docker-compose.external-ollama.yml.
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL_NAME=snowflake-arctic-embed2
EMBEDDING_DIM=1024

# --- RAG config decided by the Iterasi 0 spike (winning chunking + embedding) ---
CHUNKING_STRATEGY=recursive
COLLECTION_NAME=tkpi_gi
CHROMA_PERSIST_DIR=./chroma_db

# --- Database (PostgreSQL). Mode A: compose service. Mode B: external host. ---
DATABASE_URL=postgresql+asyncpg://diabetabot:diabetabot@postgres:5432/diabetabot

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
